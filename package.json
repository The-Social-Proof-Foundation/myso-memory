{
  "name": "memory-monorepo",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build:sdk": "pnpm --filter @socialproof/memory build",
    "dev:sdk": "pnpm --filter @socialproof/memory dev",
    "dev:noter": "pnpm --filter noter dev",
    "dev:chatbot": "pnpm --filter chatbot dev",
    "dev:app": "pnpm --filter app dev",
    "dev:researcher": "pnpm --filter researcher dev",
    "dev:docs": "pnpm --filter memory-docs dev",
    "build:docs": "pnpm --filter memory-docs build",
    "preview:docs": "pnpm --filter memory-docs serve",
    "dev:bridge": "pnpm --filter @socialproof/automation-sidecar dev",
    "build:bridge": "pnpm --filter @socialproof/automation-sidecar build",
    "start:bridge": "pnpm --filter @socialproof/automation-sidecar start",
    "test:bridge": "pnpm --filter @socialproof/automation-sidecar test",
    "typecheck:bridge": "pnpm --filter @socialproof/automation-sidecar typecheck",
    "gen:mydata-key": "pnpm --filter @socialproof/automation-sidecar gen:mydata-key",
    "docker:bridge": "docker build -f services/automation-sidecar/Dockerfile -t myso-automation-bridge .",
    "dev:automation": "cargo run --manifest-path services/automation/Cargo.toml",
    "build:automation": "cargo build --release --locked --manifest-path services/automation/Cargo.toml",
    "test:automation": "cargo test --locked --manifest-path services/automation/Cargo.toml",
    "db:automation:up": "docker compose -f services/automation/docker-compose.yml up -d",
    "db:automation:down": "docker compose -f services/automation/docker-compose.yml down",
    "test:automation-stack": "pnpm test:bridge && pnpm test:automation",
    "smoke:automation": "tsx services/automation/scripts/smoke.ts",
    "clean": "rm -rf node_modules apps/*/node_modules packages/*/node_modules services/*/node_modules packages/*/dist services/*/dist",
    "changeset": "changeset",
    "changeset:add": "changeset add",
    "version": "changeset version",
    "release": "changeset publish"
  },
  "devDependencies": {
    "@changesets/changelog-github": "^0.5.2",
    "@changesets/cli": "^2.31.0",
    "tsx": "^4.21.0",
    "typescript": "^5.9.3"
  },
  "packageManager": "pnpm@9.12.3",
  "workspaces": [
    "packages/*",
    "apps/*",
    "services/*",
    "docs"
  ]
}
