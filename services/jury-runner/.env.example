# Juror runner. Every value below is required unless it says otherwise.

# Signs the automation engine's webhooks. Use the same value as each juror job's `secret`
# (at least 16 characters).
JUROR_WEBHOOK_SECRET=

# Derives each vote's salt. Must differ from the webhook secret (at least 32 characters). If it is
# lost, a vote that is already committed can no longer be revealed.
JUROR_SALT_SECRET=

# The social server that serves cases, tasks and proposals (public data).
SOCIAL_SERVER_URL=https://social.example.com

# Any OpenAI-compatible chat completions endpoint, and the model to judge with.
INFERENCE_URL=https://llm.example.com/v1
INFERENCE_API_KEY=
INFERENCE_MODEL=
# optional, default 120000
INFERENCE_TIMEOUT_MS=

# optional: comma-separated hosts evidence may be fetched from. Empty means any public host.
EVIDENCE_ALLOWED_HOSTS=
# optional: where ipfs:// evidence is fetched from.
IPFS_GATEWAY=https://ipfs.io/ipfs/

# optional
PORT=8012
HOST=0.0.0.0
STORE_PATH=./data/judgments.json
MAX_BODY_BYTES=262144

# Crank reconciler (optional safety net, or a third party's whole crank loop). When on, the runner
# lists due cranks from the public feed and runs the ones left for GRACE_MS through the bridge,
# which signs with its JURY_CRANK_SIGNER_KEY. The cranks are permissionless: any wallet works.
# RECONCILER_ENABLED=true
# BRIDGE_URL=http://127.0.0.1:8011
# BRIDGE_SECRET=
# JURY_CRANK_OPERATOR_ID=0x...   (the bridge's operator account)
# RECONCILER_INTERVAL_MS=60000
# RECONCILER_GRACE_MS=900000
# RECONCILER_BATCH=20

# Billing a juror to AI credit instead of your own provider. The relayer reserves the funds on chain
# before it calls the model. The inference agent needs the AI-spend capability and is separate from
# the zero-spend juror delegate that votes. With this set, INFERENCE_URL/_API_KEY/_MODEL are unused.
# INFERENCE_PROVIDER=gateway
# GATEWAY_SERVER_URL=https://relayer.example.com
# GATEWAY_AGENT_KEY=<64 hex characters>
# GATEWAY_ACCOUNT_ID=0x...
# GATEWAY_MODEL_ID=anthropic/claude-sonnet
# GATEWAY_MAX_TOKENS=2048

# Publish each revealed vote's written reason to the social server so it outlives this runner. The
# server stores it only if it hashes to the digest the chain recorded. Same secret as the server's.
# INTERNAL_SYNC_SECRET=
# RATIONALE_PUBLISH_INTERVAL_MS=60000

# Operations. METRICS_TOKEN turns on GET /metrics (Prometheus text, bearer-authenticated); without it
# the route does not exist. MONITOR_DELEGATES lists the delegates this runner depends on as
# delegate:<name>@<account id>; each is checked through the bridge and warned about before it expires.
# METRICS_TOKEN=
# MONITOR_DELEGATES=delegate:juror-1@0x...,delegate:juror-2@0x...
# BRIDGE_URL=http://127.0.0.1:8011
# BRIDGE_SECRET=
# MONITOR_INTERVAL_MS=600000
# MONITOR_WARN_DAYS=14
