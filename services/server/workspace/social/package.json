{
    "name": "@socialproof/social",
    "version": "0.0.2",
    "description": "Sub-agent social actions SDK for MySocial (post, comment, react, repost)",
    "type": "module",
    "main": "./dist/index.js",
    "types": "./dist/index.d.ts",
    "exports": {
        ".": {
            "import": "./dist/index.js",
            "types": "./dist/index.d.ts"
        },
        "./ptb": {
            "import": "./dist/ptb/index.js",
            "types": "./dist/ptb/index.d.ts"
        },
        "./action-registry": {
            "import": "./dist/action-registry/index.js",
            "types": "./dist/action-registry/index.d.ts"
        }
    },
    "scripts": {
        "build": "tsc",
        "typecheck": "tsc --noEmit",
        "test": "node --import tsx --test src/ptb/post.test.ts src/ptb/mydata.test.ts src/ptb/jury.test.ts src/ptb/governance.test.ts src/action-registry/registry.test.ts src/action-registry/production-catalog.test.ts src/client.test.ts"
    },
    "dependencies": {
        "@noble/ed25519": "^2.3.0",
        "@noble/hashes": "^2.0.0",
        "@socialproof/memory": "file:../sdk"
    },
    "devDependencies": {
        "@types/node": "^20.0.0",
        "tsx": "^4.19.0",
        "typescript": "^5.5.0"
    },
    "peerDependencies": {
        "@socialproof/myso": "0.0.4"
    },
    "files": [
        "dist"
    ],
    "publishConfig": {
        "access": "public",
        "registry": "https://registry.npmjs.org/"
    },
    "license": "Apache-2.0"
}
