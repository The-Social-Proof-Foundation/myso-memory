# Server
PORT=8000

# Sidecar (MYDATA TS process; started automatically by the Rust server)
SIDECAR_PORT=9009
SIDECAR_URL=http://localhost:9009
SIDECAR_AUTH_TOKEN=

# Database (PostgreSQL + pgvector)
DATABASE_URL=postgresql://memory:memory_secret@localhost:5432/memory

# OpenAI-compatible API (for embedding)
OPENAI_API_KEY=sk-...
OPENAI_API_BASE=https://api.openai.com/v1

# Public OpenRouter model discovery (no pricing-oracle service credential needed).
# When set, this key also routes local /api/ask chat through OpenRouter, while
# embeddings still use OPENAI_API_KEY/OPENAI_API_BASE. Production inference stays
# on the AI-credit gateway when AI_CREDIT_ENABLED=true.
OPENROUTER_API_BASE=https://openrouter.ai/api/v1
OPENROUTER_API_KEY=

# MySo Network (for onchain verification)
# Controls network-dependent defaults (RPC, MYDATA)
MYSO_NETWORK=mainnet
MYSO_RPC_URL=https://fullnode.mainnet.mysosocial.network:443
# Optional Orderbook Indexer base URL for dex_list_markets. Mainnet/testnet
# defaults follow MYSO_NETWORK; set this explicitly for localnet/custom deployments.
# Remote endpoints must use HTTPS. Local development may use a loopback HTTP URL.
ORDERBOOK_INDEXER_URL=

# Localnet only: fill missing social/messaging shared-object IDs from GraphQL,
# then verify every discovered object type and shared owner against the fullnode.
# Valid explicit IDs win. On localnet, stale IDs invalidated by force-regenesis
# are replaced; remote deployments never replace explicit pins. Remote defaults off.
SOCIAL_CHAIN_AUTO_DISCOVERY=false
SOCIAL_CHAIN_GRAPHQL_URL=http://127.0.0.1:9125/graphql

# Encrypted memory and MySo Agents task artifacts use Cloudflare R2 by default.
# MEMORY_BLOB_BACKEND=r2
# R2_BUCKET=your-private-agent-memory-bucket
# R2_ENDPOINT=https://<CLOUDFLARE_ACCOUNT_ID>.r2.cloudflarestorage.com
# R2_ACCESS_KEY_ID=
# R2_SECRET_ACCESS_KEY=
# R2_REGION=auto

# Server wallet (deployer = TEE admin) — required for MYDATA decrypt
SERVER_MYSO_PRIVATE_KEY=mysoprivkey1...

# Optional localnet sponsor key pool; not used for R2 storage.
SERVER_MYSO_PRIVATE_KEYS=mysoprivkey1...,mysoprivkey1...

# Authenticated MCP -> PoC oracle identity/beneficiary transfer bridge. Keep
# this private key separate from the oracle's Identity Verification service secret.
# Enable only after the same MYSO_POC_MCP_SERVICE_SECRET is configured on the
# PoC oracle service and its identity-verification service is configured.
# MYSO_POC_ORACLE_URL=https://poc-oracle.example
# MYSO_POC_MCP_SERVICE_SECRET=  # use a random secret of at least 32 bytes
# POC_BENEFICIARY_TRANSFER_ENABLED=false

# Social server (sub-agent index for auth resolution)
SOCIAL_SERVER_URL=http://127.0.0.1:9126
# Shared secret for internal endpoints (`x-internal-sync-secret`). The messaging
# relayer and the automation engine use the same value under this same name.
INTERNAL_SYNC_SECRET=replace-with-shared-social-server-secret

# Automation engine proxy (`/api/automation/*`).
#
# The chat-app cannot hold the automation engine's shared secret, so it signs with an
# agent key and this server proxies with ownership stamped from that signature. Leaving
# this unset is safe: the routes answer 503 and the chat-app reports the engine as not
# configured, rather than exposing an unauthenticated path to it.
# AUTOMATION_ENGINE_URL=http://127.0.0.1:8010
# Defaults to INTERNAL_SYNC_SECRET, which is the value the engine expects.
# AUTOMATION_ENGINE_SECRET=
# Optional deployment allowlist for `webhook` automation jobs (comma separated hosts). When set,
# a job's webhook must call one of these; when empty, only the job's own allowed_hosts apply.
# AUTOMATION_WEBHOOK_ALLOWED_HOSTS=

# Authenticated social action discovery and registry-only transaction building.
# All seven object IDs are required before /config or /api/agent/context exposes
# socialChain. Agents discover these values; do not copy them into prompts.
USERNAME_REGISTRY_ID=0x...
# Optional social_contracts::memory::MemoryRegistry required for owner-wallet migration.
# This is separate from the relayer MEMORY_REGISTRY_ID above.
SOCIAL_MEMORY_REGISTRY_ID=0x...
PLATFORM_REGISTRY_ID=0x...
PLATFORM_OBJECT_ID=0x...
BLOCK_LIST_REGISTRY_ID=0x...
POST_CONFIG_ID=0x...
MEMORY_CONFIG_ID=0x...
MYDATA_REGISTRY_ID=0x...
SOCIAL_GRAPH_ID=0x...
# agent_task::TaskConfig, needed by the task.* registered actions (auto-discovered on localnet).
TASK_CONFIG_ID=0x...
# The AI jury. All three are discovered automatically when SOCIAL_CHAIN_AUTO_DISCOVERY is on.
JURY_CONFIG_ID=0x...
JURY_BUNDLE_RUNNER_URL=https://jury-runner.example.com
JURY_BUNDLE_READ_TOKEN= # must match the runner's BUNDLE_READ_TOKEN (at least 32 characters)
JUROR_ROSTER_ID=0x...
ECOSYSTEM_TREASURY_ID=0x...
MESSAGING_PACKAGE_ID=0x...
MESSAGING_VERSION_ID=0x...
MESSAGING_CONFIG_ID=0x...
MESSAGING_NAMESPACE_ID=0x...
MESSAGING_GROUP_MANAGER_ID=0x...
MESSAGING_GROUP_LEAVER_ID=0x...

# Legacy private-key HTTP transport is disabled by default. Never enable in production.
ALLOW_LEGACY_SOCIAL_KEY_FORWARDING=false
ALLOW_LEGACY_DELEGATE_KEY_FORWARDING=false
ALLOW_PUBLIC_GENERIC_SPONSOR=false

# Exact-MIST AI inference gateway. When enabled, the shared secret is required
# and all production LLM inference uses reserve -> provider -> capture/cancel.
AI_CREDIT_ENABLED=false
AI_CREDIT_ORACLE_URL=http://127.0.0.1:8095
AI_CREDIT_ORACLE_API_SECRET=
DEFAULT_LLM_MODEL=openai/gpt-4o-mini

# Contract IDs — required
MEMORY_PACKAGE_ID=0x...
MEMORY_REGISTRY_ID=0x...

# MYDATA key servers (comma-separated object IDs; each ID must be unique —
# duplicates are ignored at runtime)
# Required for MYDATA encrypt/decrypt in sidecar scripts
#
# On MYSO_NETWORK=localnet, if none of these objects exist on chain (a regenesis
# invalidates them) the sidecar looks up `<MYDATA_PACKAGE_ID>::key_server::KeyServer`
# through SOCIAL_CHAIN_GRAPHQL_URL, verifies each hit against the fullnode, and uses
# those instead, logging a warning. Remote networks never auto-replace a pin.
MYDATA_KEY_SERVERS=0x...,0x...
# Package holding key_server::KeyServer (default 0xda7a, the local framework address).
# MYDATA_PACKAGE_ID=0xda7a

# MYDATA threshold — minimum number of key servers that must respond for
# encrypt/decrypt to succeed. Must be ≤ number of entries in MYDATA_KEY_SERVERS.
# Default: 2 (requires at least 2 key servers configured above)
MYDATA_THRESHOLD=2
MYDATA_DECRYPT_THRESHOLD=2

# Enoki Sponsored Transactions (sidecar)
ENOKI_API_KEY=
ENOKI_NETWORK=mainnet

# Localnet-only gas sponsorship using SERVER_MYSO_PRIVATE_KEYS. The agent/owner
# still signs every transaction; this key pool signs only as gas owner.
LOCAL_SPONSOR_ENABLED=false
LOCAL_SPONSOR_GAS_BUDGET=100000000

# Sponsor endpoint rate limiting (per IP + per sender, sliding window)
SPONSOR_RATE_LIMIT_PER_MINUTE=10
SPONSOR_RATE_LIMIT_PER_HOUR=30

# CORS — comma-separated list of allowed browser origins
# If unset, CORS is deny-all (browsers blocked) — always set this in production
#
# Production:
# ALLOWED_ORIGINS=https://mysocial.network,https://noter.demo.mysocial.network,https://chatbot.demo.mysocial.network,https://researcher.demo.mysocial.network
#
# Staging:
# ALLOWED_ORIGINS=https://testnet.mysocial.network,https://noter.demo.testnet.mysocial.network,https://chatbot.demo.testnet.mysocial.network,https://researcher.demo.testnet.mysocial.network
#
# Local dev:
ALLOWED_ORIGINS=http://localhost:3000

# Passkey PRF agent backups (ciphertext only). Off until deployment/device tests pass.
ENABLE_AGENT_KEY_BACKUPS=false
PASSKEY_RP_ID=localhost
PASSKEY_ALLOWED_ORIGINS=http://localhost:5173
KEY_BACKUP_SERVICE_ORIGIN=http://localhost:8000

# Custody tiers accepted for agent-key root wraps (comma-separated).
# passkey-prf-v1      WebAuthn PRF passkey (strongest; the only pre-tier mechanism)
# recovery-code-v1    login key + a user-held recovery code
# device-key-v1       random per-device wrap secret
# zklogin-root-v1     derived from the MySocial login key (as strong as the wallet login)
# Dropping passkey-prf-v1 makes PASSKEY_RP_ID/PASSKEY_ALLOWED_ORIGINS/KEY_BACKUP_SERVICE_ORIGIN
# optional (they are still validated when set).
AGENT_KEY_CUSTODY_TIERS=passkey-prf-v1,zklogin-root-v1,recovery-code-v1

# Optional minimum tier required to unlock (e.g. passkey-prf-v1 reproduces passkey-only custody).
# Unset means any enabled tier may unlock.
# AGENT_KEY_REQUIRE_TIER=passkey-prf-v1

# Per-account owner-challenge / custody-unlock limit per minute (0 disables all unlocks).
AGENT_KEY_UNLOCK_PER_MINUTE=10

# Direct MyData P2P actions: opt in only after deploying the matching framework.
MYDATA_BOUNDED_PURCHASE_ENABLED=false
MYDATA_POST_ACCESS_PURCHASE_ENABLED=false
MYDATA_CONFIG_ID=0x...
ECOSYSTEM_TREASURY_ID=0x...
# Separate private-content disclosure gate. Requires MEMORY_CONFIG_ID,
# BLOCK_LIST_REGISTRY_ID and the source-synchronized session-capable sidecar.
# Validate live key-server access/revocation before enabling in production.
MYDATA_LISTING_ACCESS_ENABLED=false

# Profile subscription actions: opt in only after deploying the matching plan
# guards and renewal toggle, applying migration 018 and upgrading SDK/MCP/sidecar.
SUBSCRIPTION_CONFIG_ID=0x...
SUBSCRIPTION_ACTIONS_ENABLED=false

# Exact owner-wallet Coin<T> transfer tool (registry 1.9). Requires existing
# prepare/sign/submit sponsorship and migration 018; no new Move entry point.
# Keep disabled until owner-run quote/approval/coin/effect/receipt checks pass.
TOKEN_TRANSFERS_ENABLED=false

# Creator-vault claims are owner-wallet transactions. Enable only after configuring POC_CONFIG_ID
# and ECOSYSTEM_TREASURY_ID for the deployed proof_of_creativity package.
POC_CONFIG_ID=
POC_VAULT_CLAIMS_ENABLED=false
SPOT_PAYOUT_CLAIMS_ENABLED=false
SPOT_BETTING_ENABLED=false
SPOT_MARKET_CREATION_ENABLED=false
SPOT_CONFIG_ID=
SPOT_CLAIM_REGISTRY_ID=
SPT_TRADING_ENABLED=false
SPT_REGISTRY_ID=
SPT_CONFIG_ID=
