# Server
PORT=8000

# Sidecar (MYDATA + File Storage TS process; started automatically by the Rust server)
SIDECAR_PORT=9009
SIDECAR_URL=http://localhost:9009
SIDECAR_AUTH_TOKEN=

# Database (PostgreSQL + pgvector)
DATABASE_URL=postgresql://memory:memory_secret@localhost:5432/memory

# OpenAI-compatible API (for embedding)
OPENAI_API_KEY=sk-...
OPENAI_API_BASE=https://api.openai.com/v1

# MySo Network (for onchain verification)
# Controls all network-dependent defaults (RPC, File Storage, MYDATA)
MYSO_NETWORK=mainnet
MYSO_RPC_URL=https://fullnode.mainnet.mysosocial.network:443

# Localnet only: fill missing social/messaging shared-object IDs from GraphQL,
# then verify every discovered object type and shared owner against the fullnode.
# Valid explicit IDs win. On localnet, stale IDs invalidated by force-regenesis
# are replaced; remote deployments never replace explicit pins. Remote defaults off.
SOCIAL_CHAIN_AUTO_DISCOVERY=false
SOCIAL_CHAIN_GRAPHQL_URL=http://127.0.0.1:9125/graphql

# File Storage (publisher + aggregator)
FILE_STORAGE_PUBLISHER_URL=https://publisher.file-storage-mainnet.mysocial.network
FILE_STORAGE_AGGREGATOR_URL=https://aggregator.file-storage-mainnet.mysocial.network

# Server wallet (deployer = TEE admin) — required for MYDATA decrypt
SERVER_MYSO_PRIVATE_KEY=mysoprivkey1...

# Key pool for parallel File Storage uploads (up to 5 wallets round-robin)
# Each wallet needs MYSO + WAL tokens
SERVER_MYSO_PRIVATE_KEYS=mysoprivkey1...,mysoprivkey1...

# Social server (sub-agent index for auth resolution)
SOCIAL_SERVER_URL=http://127.0.0.1:9126
INTERNAL_SYNC_SECRET=replace-with-shared-social-server-secret

# Authenticated social action discovery and registry-only transaction building.
# All seven object IDs are required before /config or /api/agent/context exposes
# socialChain. Agents discover these values; do not copy them into prompts.
USERNAME_REGISTRY_ID=0x...
PLATFORM_REGISTRY_ID=0x...
PLATFORM_OBJECT_ID=0x...
BLOCK_LIST_REGISTRY_ID=0x...
POST_CONFIG_ID=0x...
MEMORY_CONFIG_ID=0x...
MYDATA_REGISTRY_ID=0x...
SOCIAL_GRAPH_ID=0x...
MESSAGING_PACKAGE_ID=0x...
MESSAGING_VERSION_ID=0x...
MESSAGING_CONFIG_ID=0x...
MESSAGING_NAMESPACE_ID=0x...
MESSAGING_GROUP_MANAGER_ID=0x...
MESSAGING_GROUP_LEAVER_ID=0x...

# Legacy private-key HTTP transport is disabled by default. Never enable in production.
ALLOW_LEGACY_SOCIAL_KEY_FORWARDING=false
ALLOW_LEGACY_DELEGATE_KEY_FORWARDING=false
ALLOW_PUBLIC_GENERIC_SPONSOR=false

# Exact-MIST AI inference gateway. When enabled, the shared secret is required
# and all production LLM inference uses reserve -> provider -> capture/cancel.
AI_CREDIT_ENABLED=false
AI_CREDIT_ORACLE_URL=http://127.0.0.1:8095
AI_CREDIT_ORACLE_API_SECRET=
DEFAULT_LLM_MODEL=openai/gpt-4o-mini

# Contract IDs — required
MEMORY_PACKAGE_ID=0x...
MEMORY_REGISTRY_ID=0x...

# MYDATA key servers (comma-separated object IDs; each ID must be unique —
# duplicates are ignored at runtime)
# Required for MYDATA encrypt/decrypt in sidecar scripts
MYDATA_KEY_SERVERS=0x...,0x...

# MYDATA threshold — minimum number of key servers that must respond for
# encrypt/decrypt to succeed. Must be ≤ number of entries in MYDATA_KEY_SERVERS.
# Default: 2 (requires at least 2 key servers configured above)
MYDATA_THRESHOLD=2
MYDATA_DECRYPT_THRESHOLD=2

# File Storage on-chain package ID (auto-detected from MYSO_NETWORK if not set)
# FILE_STORAGE_PACKAGE_ID=0x...

# File Storage upload relay (auto-detected from MYSO_NETWORK if not set)
# FILE_STORAGE_UPLOAD_RELAY_URL=https://upload-relay.mainnet.mysocial.network

# Enoki Sponsored Transactions (sidecar)
ENOKI_API_KEY=
ENOKI_NETWORK=mainnet

# Localnet-only gas sponsorship using SERVER_MYSO_PRIVATE_KEYS. The agent/owner
# still signs every transaction; this key pool signs only as gas owner.
LOCAL_SPONSOR_ENABLED=false
LOCAL_SPONSOR_GAS_BUDGET=100000000

# Sponsor endpoint rate limiting (per IP + per sender, sliding window)
SPONSOR_RATE_LIMIT_PER_MINUTE=10
SPONSOR_RATE_LIMIT_PER_HOUR=30

# CORS — comma-separated list of allowed browser origins
# If unset, CORS is deny-all (browsers blocked) — always set this in production
#
# Production:
# ALLOWED_ORIGINS=https://mysocial.network,https://noter.demo.mysocial.network,https://chatbot.demo.mysocial.network,https://researcher.demo.mysocial.network
#
# Staging:
# ALLOWED_ORIGINS=https://testnet.mysocial.network,https://noter.demo.testnet.mysocial.network,https://chatbot.demo.testnet.mysocial.network,https://researcher.demo.testnet.mysocial.network
#
# Local dev:
ALLOWED_ORIGINS=http://localhost:3000
