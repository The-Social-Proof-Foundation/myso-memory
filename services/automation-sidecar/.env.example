# =============================================================================
# Automation Memory Bridge — environment configuration
# Copy to .env and fill in: cp .env.example .env
#
# This service is the only component that holds agent keys. It turns a job's
# `target_agent_key_ref` into signed memory relayer calls on the agent's behalf,
# using @socialproof/memory — the same client the chat-app uses.
# =============================================================================

# -----------------------------------------------------------------------------
# Server
# -----------------------------------------------------------------------------
# Railway assigns PORT. Local default is 8011.
PORT=8011

# Bind address. Loopback by default: this process signs with agent keys, so
# exposing it to a network has to be deliberate.
#
# IN A CONTAINER THIS MUST BE 0.0.0.0. Railway does not set HOST, so a
# loopback-bound server starts, logs a healthy line, and then fails its own
# healthcheck because nothing outside the container can reach it. The Dockerfile
# sets 0.0.0.0 already; only override it if you deliberately want loopback.
HOST=127.0.0.1

# -----------------------------------------------------------------------------
# Shared secret (REQUIRED — the bridge refuses to start without it)
# -----------------------------------------------------------------------------
# Sent and expected as the `x-internal-sync-secret` header.
#
# The stack historically used two names for this one value: the memory and
# messaging relayers read INTERNAL_SYNC_SECRET, while the automation engine
# reads AUTOMATION_INTERNAL_SYNC_SECRET. The bridge accepts either, preferring
# INTERNAL_SYNC_SECRET. Set ONE value and reuse it everywhere:
#
#   memory relayer      INTERNAL_SYNC_SECRET
#   messaging relayer   INTERNAL_SYNC_SECRET
#   automation engine   AUTOMATION_INTERNAL_SYNC_SECRET
#   this bridge         INTERNAL_SYNC_SECRET
INTERNAL_SYNC_SECRET=dev-automation-secret

# -----------------------------------------------------------------------------
# Memory relayer
# -----------------------------------------------------------------------------
# Relayer origin used for any key entry that does not pin its own serverUrl.
# A network mismatch here is the most common cause of an opaque auth failure,
# so prefer setting serverUrl per key when you run more than one network.
MEMORY_SERVER_URL=http://127.0.0.1:8000

# -----------------------------------------------------------------------------
# Signing keys: sealed delegates (production) or a static file (local dev only)
# -----------------------------------------------------------------------------
# PRODUCTION (NODE_ENV=production) is non-custodial: the bridge holds no user agent key.
# Unattended jobs sign as a *delegate* the owner registers on-chain (memory-only, spend-
# capped, expiring, revocable). The delegate's seed is sealed in the owner's browser to
# THIS bridge's public key and stored only as ciphertext in the engine's database.
#
# In production the bridge REFUSES to start if AUTOMATION_AGENT_KEYS_JSON or
# AUTOMATION_AGENT_KEYS_FILE is set, and requires the three variables below.
#
# Generate the seal key on your own machine:   pnpm gen:seal-key
#   AUTOMATION_SEAL_PRIVATE_KEYS=<id>:<key>   <- bridge secret (the only one that matters)
#   VITE_AUTOMATION_SEAL_KEY=<id>:<key>       <- public; goes in the chat-app build
# Several keys can be listed (id1:key1,id2:key2) so one can be rotated out.
# AUTOMATION_SEAL_PRIVATE_KEYS=

# Where sealed delegate keys are stored. Falls back to AUTOMATION_EVENTS_URL.
# AUTOMATION_ENGINE_URL=http://127.0.0.1:8010

# --- LOCAL DEVELOPMENT ONLY: a static key file ---------------------------------
# Plaintext Ed25519 seeds. Use a throwaway agent on a dev network. Mapping is
# `target_agent_key_ref` -> { key, accountId, serverUrl?, namespace?, platformId? }.
# `accountId` is the authorization: a ref only works for jobs of that account.
AUTOMATION_AGENT_KEYS_FILE=./agents.json
# AUTOMATION_AGENT_KEYS_JSON=   (also dev only: raw JSON or base64 of it)

# Namespace applied when a key entry omits one.
#
# Defaults to `chat-app` so a scheduled job writes memories the chat-app can
# recall — the chat-app scopes its own recall to that same namespace. Changing
# this isolates the two clients from each other.
AUTOMATION_DEFAULT_NAMESPACE=chat-app

# -----------------------------------------------------------------------------
# Limits
# -----------------------------------------------------------------------------
# Ceiling for a single memory relayer round trip (recall or remember-and-wait).
AUTOMATION_REQUEST_TIMEOUT_MS=30000
# Cap on an inbound request body, so a bad caller cannot exhaust memory.
AUTOMATION_MAX_BODY_BYTES=262144

# -----------------------------------------------------------------------------
# Optional: publish `memory.created` events back to the automation engine
# -----------------------------------------------------------------------------
# When set, a successful remember POSTs a normalized event to
# {AUTOMATION_EVENTS_URL}/internal/automation/events, which is what lets an
# event-triggered job react to a memory the bridge just stored. Leave unset to
# disable. Publishing is best-effort: a failure never fails the write.
# AUTOMATION_EVENTS_URL=http://127.0.0.1:8010
# Falls back to INTERNAL_SYNC_SECRET when unset.
# AUTOMATION_EVENTS_SECRET=
