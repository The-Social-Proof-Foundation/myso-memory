# =============================================================================
# Automation Engine — environment configuration
# Copy to .env and fill in: cp .env.example .env
#
# Railway Root Directory: services/automation
# =============================================================================

# Railway assigns PORT. Local default is 8010.
PORT=8010
# When false the engine still serves its HTTP API but runs no jobs: no tick
# loop, no event consumer. Useful for dark-launching or draining a replica.
AUTOMATION_ENABLED=true
AUTOMATION_TICK_INTERVAL_SECS=60

# -----------------------------------------------------------------------------
# Shared secret (x-internal-sync-secret)
# -----------------------------------------------------------------------------
# Set ONE value and reuse it across the stack. This engine prefers
# INTERNAL_SYNC_SECRET (the name the memory and messaging relayers read) and
# still accepts the legacy AUTOMATION_INTERNAL_SYNC_SECRET. Two names with two
# different defaults on the same header is a guaranteed 401 in a real deploy.
INTERNAL_SYNC_SECRET=dev-automation-secret
# AUTOMATION_INTERNAL_SYNC_SECRET=dev-automation-secret

# -----------------------------------------------------------------------------
# Persistence
# -----------------------------------------------------------------------------
# Railway Postgres. Without this, jobs and runs live only in process memory and
# disappear on restart. Give the automation engine its OWN database — do not
# point it at the memory relayer's.
# DATABASE_URL=postgresql://automation:automation@localhost:5433/automation

# -----------------------------------------------------------------------------
# Memory bridge (REQUIRED for any memory work)
# -----------------------------------------------------------------------------
# This engine holds no agent keys and cannot sign memory relayer requests, so
# every recall/remember goes through the bridge in services/automation-sidecar,
# which resolves the job's target_agent_key_ref and signs with the agent's own
# Ed25519 seed via @socialproof/memory.
#
# There is no MEMORY_SERVER_URL here on purpose: the bridge owns the relayer
# origin, because it owns the key material and therefore owns the network choice.
AUTOMATION_MEMORY_BRIDGE_URL=http://127.0.0.1:8011
# Falls back to INTERNAL_SYNC_SECRET when unset.
# AUTOMATION_MEMORY_BRIDGE_SECRET=

# -----------------------------------------------------------------------------
# AI credit oracle
# -----------------------------------------------------------------------------
# Deployed AI credit oracle public URL. Local default is the oracle listen port.
# Every run preflights here; a rejected or approval-required preflight skips the
# run without executing it.
AI_CREDIT_ORACLE_URL=http://127.0.0.1:8095
# Must equal the oracle's AI_CREDIT_ORACLE_API_SECRET (and the memory relayer's
# value of the same name). The oracle returns a bodyless 401 without it, which
# fails every run at preflight.
# AI_CREDIT_ORACLE_API_SECRET=

# -----------------------------------------------------------------------------
# Social server (audit trail)
# -----------------------------------------------------------------------------
SOCIAL_SERVER_URL=http://127.0.0.1:9126
# Required to push audit entries. Without it, runs are recorded locally only.
# AUDIT_SYNC_SECRET=

# -----------------------------------------------------------------------------
# Workflow relayer (notifications)
# -----------------------------------------------------------------------------
# Optional. When set, a completed run nudges the workflow inbox with a due task
# and a failed run raises an alert. Unset to keep runs silent.
# WORKFLOW_RELAYER_URL=http://127.0.0.1:3003
# Must match the messaging relayer's INTERNAL_SYNC_SECRET.
# WORKFLOW_SYNC_SECRET=
