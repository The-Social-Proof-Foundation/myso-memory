# Railway assigns PORT. Local default is 8010.
PORT=8010
AUTOMATION_ENABLED=true
AUTOMATION_INTERNAL_SYNC_SECRET=dev-automation-secret
AUTOMATION_TICK_INTERVAL_SECS=60

# Railway Postgres. Without this, jobs live only in process memory and disappear on restart.
# DATABASE_URL=postgresql://memory:memory_secret@localhost:5432/automation

# Deployed AI credit oracle public URL. Local default is the oracle listen port.
AI_CREDIT_ORACLE_URL=http://127.0.0.1:8095

SOCIAL_SERVER_URL=http://127.0.0.1:9126
# AUDIT_SYNC_SECRET=

# Required for a due memory_relayer_call. The run fails when either is unset.
# WORKFLOW_RELAYER_URL=http://127.0.0.1:8080
# WORKFLOW_SYNC_SECRET=

MEMORY_SERVER_URL=http://127.0.0.1:8000
